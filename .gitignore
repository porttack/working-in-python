*.py[co]

# Packages
*.egg
*.egg-info
dist
build
eggs
parts
bin
var
sdist
develop-eggs
.installed.cfg

# Installer logs
pip-log.txt

# Unit test / coverage reports
.coverage
.tox

#Translations
*.mo

#Mr Developer
.mr.developer.cfg

# apcsp: dated working copies for live annotation (CLAUDE.md layout: sessions/)
sessions/

# apcsp: framework extracts must never be committed (CLAUDE.md non-negotiable #1) --
# these stay in scratch, outside the repo; ignored here as a backstop in case one
# is ever placed under standards/ again.
standards/*.pdf
scratch/

# chapters/: .ipynb is the sole source of truth
chapters/*.md

# Jupyter Book build artifacts
jb/chap*.ipynb
jb/_build/
jb/conf.py

# Local virtualenv for jupyter-book/ghp-import (pinned <2, see PUBLISHING.md)
.venv/

# JupyterLite build: content/ is generated by tools/build_jupyterlite_content.py,
# _output/ is the built static site. Neither is hand-edited or committed. See
# AUDIT.md, 2026-08-07.
jupyterlite/content/
jupyterlite/_output/
.jupyterlite.doit.db
